    {
      "cell_type": "code",
      "source": [
        "\"\"\"\n",
        "Retailer Quarterly Revenue Forecasting System\n",
        "==============================================\n",
        "Upload any Excel file with Quarter/Date and Sales columns.\n",
        "Automatically generates 20-quarter (5-year) forward projections.\n",
        "\n",
        "Supports quarter formats:\n",
        "  - \"Q1 2023\", \"2023 Q1\", \"2023-Q1\"\n",
        "  - Date columns (parsed to quarter)\n",
        "  - Numeric quarter index (1, 2, 3, ...)\n",
        "\n",
        "Usage:\n",
        "    forecaster = RetailerQuarterlyForecaster('Retailer.xlsx')\n",
        "    forecaster.run_full_analysis()\n",
        "    forecaster.export_results('forecast_output.xlsx')\n",
        "\"\"\"\n",
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "from scipy import stats\n",
        "from datetime import datetime\n",
        "import re\n",
        "import warnings\n",
        "warnings.filterwarnings('ignore')\n",
        "\n",
        "try:\n",
        "    import matplotlib.pyplot as plt\n",
        "    import matplotlib.ticker as mticker\n",
        "    PLOTTING_AVAILABLE = True\n",
        "except ImportError:\n",
        "    PLOTTING_AVAILABLE = False\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------------------------\n",
        "# Helpers\n",
        "# ---------------------------------------------------------------------------\n",
        "\n",
        "def _parse_quarter_label(val) -> tuple[int, int] | None:\n",
        "    \"\"\"\n",
        "    Try to extract (year, quarter) from many common formats.\n",
        "    Returns None if parsing fails.\n",
        "    \"\"\"\n",
        "    s = str(val).strip()\n",
        "\n",
        "    # \"Q1 2023\" or \"q1-2023\" or \"2023-Q1\" or \"2023 Q1\"\n",
        "    m = re.search(r'[Qq](\\d)\\D*(\\d{4})', s)\n",
        "    if m:\n",
        "        return int(m.group(2)), int(m.group(1))\n",
        "    m = re.search(r'(\\d{4})\\D*[Qq](\\d)', s)\n",
        "    if m:\n",
        "        return int(m.group(1)), int(m.group(2))\n",
        "\n",
        "    # Try as a proper date → derive quarter\n",
        "    try:\n",
        "        dt = pd.to_datetime(val, errors='raise')\n",
        "        return dt.year, (dt.month - 1) // 3 + 1\n",
        "    except Exception:\n",
        "        pass\n",
        "\n",
        "    # Bare integer / float year → assume Q1\n",
        "    try:\n",
        "        yr = int(float(s))\n",
        "        if 1900 < yr < 2200:\n",
        "            return yr, 1\n",
        "    except Exception:\n",
        "        pass\n",
        "\n",
        "    return None\n",
        "\n",
        "\n",
        "def _quarter_index(year: int, quarter: int) -> int:\n",
        "    \"\"\"Convert (year, quarter) to a monotonic integer index for regression.\"\"\"\n",
        "    return year * 4 + quarter\n",
        "\n",
        "\n",
        "def _index_to_label(idx: int) -> str:\n",
        "    quarter = idx % 4\n",
        "    if quarter == 0:\n",
        "        quarter = 4\n",
        "        year = idx // 4 - 1\n",
        "    else:\n",
        "        year = idx // 4\n",
        "    return f\"Q{quarter} {year}\"\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------------------------\n",
        "# Main class\n",
        "# ---------------------------------------------------------------------------\n",
        "\n",
        "class RetailerQuarterlyForecaster:\n",
        "    \"\"\"\n",
        "    Complete quarterly revenue forecasting system for retailers.\n",
        "    Handles data loading, cleaning, seasonal decomposition, model\n",
        "    selection via backtesting, and multi-quarter forecasting.\n",
        "    \"\"\"\n",
        "\n",
        "    def __init__(self, file_path: str):\n",
        "        self.raw_data = None\n",
        "        self.clean_data = None          # columns: year, quarter, qidx, sales, label\n",
        "        self.data_excl_outliers = None\n",
        "        self.outliers = []              # list of qidx values flagged\n",
        "        self.seasonal_indices = None    # shape (4,) — Q1..Q4 seasonal factors\n",
        "        self.forecasts = {}\n",
        "        self.backtest_results = None\n",
        "        self.best_method = None\n",
        "        self.final_forecast = None\n",
        "\n",
        "        self.load_data(file_path)\n",
        "\n",
        "    # =========================================================================\n",
        "    # DATA LOADING\n",
        "    # =========================================================================\n",
        "\n",
        "    def load_data(self, file_path: str) -> 'RetailerQuarterlyForecaster':\n",
        "        if file_path.endswith(('.xlsx', '.xls')):\n",
        "            self.raw_data = pd.read_excel(file_path)\n",
        "        else:\n",
        "            raise ValueError(\"Only Excel files (.xlsx, .xls) are supported.\")\n",
        "        self._prepare_data()\n",
        "        return self\n",
        "\n",
        "    def _prepare_data(self) -> None:\n",
        "        df = self.raw_data.copy()\n",
        "\n",
        "        # ---- identify date/quarter column ----\n",
        "        date_col = None\n",
        "        for col in df.columns:\n",
        "            cl = col.lower()\n",
        "            if any(t in cl for t in ['quarter', 'qtr', 'date', 'period', 'year', 'time']):\n",
        "                date_col = col\n",
        "                break\n",
        "        if date_col is None:\n",
        "            date_col = df.columns[0]\n",
        "\n",
        "        # ---- identify sales column ----\n",
        "        sales_col = None\n",
        "        for col in df.columns:\n",
        "            cl = col.lower()\n",
        "            if any(t in cl for t in ['sales', 'revenue', 'amount', 'value']):\n",
        "                sales_col = col\n",
        "                break\n",
        "        if sales_col is None:\n",
        "            sales_col = df.columns[1]\n",
        "\n",
        "        # ---- parse quarter labels ----\n",
        "        parsed = df[date_col].apply(_parse_quarter_label)\n",
        "        valid = parsed.dropna()\n",
        "        if valid.empty:\n",
        "            raise ValueError(\n",
        "                f\"Could not parse quarter information from column '{date_col}'. \"\n",
        "                \"Expected formats like 'Q1 2023', '2023-Q2', or date values.\"\n",
        "            )\n",
        "\n",
        "        years   = valid.apply(lambda x: x[0])\n",
        "        quarters = valid.apply(lambda x: x[1])\n",
        "\n",
        "        tmp = pd.DataFrame({\n",
        "            'year':    years.values,\n",
        "            'quarter': quarters.values,\n",
        "            'sales':   pd.to_numeric(df.loc[valid.index, sales_col], errors='coerce').values\n",
        "        }).dropna()\n",
        "\n",
        "        tmp['qidx']  = [_quarter_index(int(y), int(q)) for y, q in zip(tmp['year'], tmp['quarter'])]\n",
        "        tmp['label'] = [f\"Q{int(q)} {int(y)}\" for y, q in zip(tmp['year'], tmp['quarter'])]\n",
        "\n",
        "        tmp = (tmp\n",
        "               .drop_duplicates(subset=['qidx'])\n",
        "               .sort_values('qidx')\n",
        "               .reset_index(drop=True))\n",
        "        tmp['year']    = tmp['year'].astype(int)\n",
        "        tmp['quarter'] = tmp['quarter'].astype(int)\n",
        "\n",
        "        self.clean_data = tmp\n",
        "\n",
        "        self._compute_seasonal_indices()\n",
        "        self._detect_outliers()\n",
        "\n",
        "        n = len(self.clean_data)\n",
        "        yr_start = self.clean_data['label'].iloc[0]\n",
        "        yr_end   = self.clean_data['label'].iloc[-1]\n",
        "        print(f\"✓ Loaded {n} quarters of data\")\n",
        "        print(f\"  Period: {yr_start} – {yr_end}\")\n",
        "        if self.outliers:\n",
        "            labels = self.clean_data.loc[\n",
        "                self.clean_data['qidx'].isin(self.outliers), 'label'\n",
        "            ].tolist()\n",
        "            print(f\"  Detected outliers: {labels}\")\n",
        "\n",
        "    # =========================================================================\n",
        "    # SEASONAL DECOMPOSITION\n",
        "    # =========================================================================\n",
        "\n",
        "    def _compute_seasonal_indices(self) -> None:\n",
        "        \"\"\"\n",
        "        Compute seasonal indices using ratio-to-trend method.\n",
        "        Works with as few as 4 quarters. For 8+ quarters uses the\n",
        "        full ratio-to-centred-moving-average. Normalises so mean = 1.\n",
        "        \"\"\"\n",
        "        df = self.clean_data.copy()\n",
        "\n",
        "        quarters_present = df['quarter'].unique()\n",
        "        if len(quarters_present) < 2:\n",
        "            self.seasonal_indices = np.ones(4)\n",
        "            return\n",
        "\n",
        "        if len(df) >= 8:\n",
        "            sales = df['sales'].values\n",
        "            ma = np.convolve(sales, np.ones(4)/4, mode='same')\n",
        "            ratios = [[] for _ in range(4)]\n",
        "            for i in range(2, len(sales) - 2):\n",
        "                q = df['quarter'].iloc[i] - 1\n",
        "                if ma[i] > 0:\n",
        "                    ratios[q].append(sales[i] / ma[i])\n",
        "            indices = np.array([np.mean(r) if r else 1.0 for r in ratios])\n",
        "        else:\n",
        "            # Ratio-to-trend: de-trend with linear fit first, then\n",
        "            # average each quarter's ratio to get its seasonal factor.\n",
        "            qidx  = df['qidx'].values.astype(float)\n",
        "            sales = df['sales'].values\n",
        "            slope, intercept, *_ = stats.linregress(qidx, sales)\n",
        "            trend     = intercept + slope * qidx\n",
        "            detrended = sales / trend\n",
        "\n",
        "            q_mean = {}\n",
        "            for loc, (_, row) in enumerate(df.iterrows()):\n",
        "                q = int(row['quarter']) - 1\n",
        "                q_mean.setdefault(q, []).append(detrended[loc])\n",
        "\n",
        "            indices = np.ones(4)\n",
        "            for q, vals in q_mean.items():\n",
        "                indices[q] = np.mean(vals)\n",
        "\n",
        "        indices = indices / indices.mean()\n",
        "        self.seasonal_indices = indices\n",
        "        print(f\"  Seasonal indices -> Q1:{indices[0]:.3f}  Q2:{indices[1]:.3f}  \"\n",
        "              f\"Q3:{indices[2]:.3f}  Q4:{indices[3]:.3f}\")\n",
        "\n",
        "    def _deseasonalise(self, sales: np.ndarray, quarters: np.ndarray) -> np.ndarray:\n",
        "        return sales / self.seasonal_indices[quarters - 1]\n",
        "\n",
        "    def _reseasonalise(self, values: np.ndarray, quarters: np.ndarray) -> np.ndarray:\n",
        "        return values * self.seasonal_indices[quarters - 1]\n",
        "\n",
        "    # =========================================================================\n",
        "    # OUTLIER DETECTION\n",
        "    # =========================================================================\n",
        "\n",
        "    def _detect_outliers(self, threshold: float = 2.5) -> None:\n",
        "        df = self.clean_data.copy()\n",
        "        ds = self._deseasonalise(df['sales'].values, df['quarter'].values)\n",
        "        growth = np.diff(ds) / ds[:-1]\n",
        "        if growth.std() > 0:\n",
        "            z = (growth - growth.mean()) / growth.std()\n",
        "            outlier_idx = np.where(np.abs(z) > threshold)[0] + 1  # offset: diff reduces length by 1\n",
        "            self.outliers = df['qidx'].iloc[outlier_idx].tolist()\n",
        "\n",
        "        self.data_excl_outliers = self.clean_data[\n",
        "            ~self.clean_data['qidx'].isin(self.outliers)\n",
        "        ].copy().reset_index(drop=True)\n",
        "\n",
        "    # =========================================================================\n",
        "    # SUMMARY STATISTICS\n",
        "    # =========================================================================\n",
        "\n",
        "    def summary_stats(self, exclude_outliers: bool = True) -> dict:\n",
        "        df = self.data_excl_outliers if exclude_outliers else self.clean_data\n",
        "        sales   = df['sales'].values\n",
        "        n       = len(sales)\n",
        "        growth  = np.diff(sales) / sales[:-1]\n",
        "\n",
        "        # Annual CAGR: n quarters span n/4 years\n",
        "        years_span = (n - 1) / 4\n",
        "        cagr = (np.power(sales[-1] / sales[0], 1 / years_span) - 1) if years_span > 0 else 0\n",
        "\n",
        "        return {\n",
        "            'n_quarters':          n,\n",
        "            'first_quarter':       df['label'].iloc[0],\n",
        "            'last_quarter':        df['label'].iloc[-1],\n",
        "            'first_sales':         sales[0],\n",
        "            'last_sales':          sales[-1],\n",
        "            'total_growth_pct':    (sales[-1] / sales[0] - 1) * 100,\n",
        "            'annual_cagr_pct':     cagr * 100,\n",
        "            'avg_qoq_growth_pct':  np.mean(growth) * 100 if len(growth) else 0,\n",
        "            'med_qoq_growth_pct':  np.median(growth) * 100 if len(growth) else 0,\n",
        "            'growth_volatility':   np.std(growth) * 100 if len(growth) else 0,\n",
        "            'min_qoq_growth_pct':  np.min(growth) * 100 if len(growth) else 0,\n",
        "            'max_qoq_growth_pct':  np.max(growth) * 100 if len(growth) else 0,\n",
        "            'seasonal_indices':    dict(zip(['Q1','Q2','Q3','Q4'], np.round(self.seasonal_indices, 4))),\n",
        "            'outliers_excluded':   self.outliers if exclude_outliers else [],\n",
        "        }\n",
        "\n",
        "    # =========================================================================\n",
        "    # FORECASTING METHODS  (all work on de-seasonalised data, then re-apply)\n",
        "    # =========================================================================\n",
        "\n",
        "    def _future_quarters(self, last_qidx: int, periods: int):\n",
        "        \"\"\"Return (qidx array, quarter array, label list) for future periods.\"\"\"\n",
        "        future_qidx    = np.arange(last_qidx + 1, last_qidx + 1 + periods)\n",
        "        future_quarters = np.array([(qi % 4) if (qi % 4) != 0 else 4 for qi in future_qidx])\n",
        "        future_labels  = [_index_to_label(qi) for qi in future_qidx]\n",
        "        return future_qidx, future_quarters, future_labels\n",
        "\n",
        "    def _forecast_linear(self, df: pd.DataFrame, periods: int) -> dict:\n",
        "        qidx   = df['qidx'].values.astype(float)\n",
        "        ds     = self._deseasonalise(df['sales'].values, df['quarter'].values)\n",
        "\n",
        "        slope, intercept, r, _, se = stats.linregress(qidx, ds)\n",
        "        fq, fquarters, flabels = self._future_quarters(int(qidx[-1]), periods)\n",
        "\n",
        "        ds_fc  = intercept + slope * fq\n",
        "        fc     = self._reseasonalise(ds_fc, fquarters)\n",
        "\n",
        "        n = len(qidx)\n",
        "        se_fc = se * np.sqrt(1 + 1/n + (fq - qidx.mean())**2 / np.sum((qidx - qidx.mean())**2))\n",
        "        ci_lo = self._reseasonalise(ds_fc - 1.645 * se_fc * np.sqrt(n), fquarters)\n",
        "        ci_hi = self._reseasonalise(ds_fc + 1.645 * se_fc * np.sqrt(n), fquarters)\n",
        "\n",
        "        return {'method':'linear','forecast':fc,'qidx':fq,'quarters':fquarters,\n",
        "                'labels':flabels,'r_squared':r**2,'ci_lower':ci_lo,'ci_upper':ci_hi}\n",
        "\n",
        "    def _forecast_cagr(self, df: pd.DataFrame, periods: int, lookback: int = None) -> dict:\n",
        "        sales   = df['sales'].values\n",
        "        qidx    = df['qidx'].values\n",
        "        ds      = self._deseasonalise(sales, df['quarter'].values)\n",
        "\n",
        "        lb = lookback if lookback and lookback < len(ds) else len(ds)\n",
        "        base = ds[-lb]\n",
        "        n_q  = lb - 1\n",
        "        qoq_growth = np.power(ds[-1] / base, 1 / n_q) - 1 if n_q > 0 else 0\n",
        "\n",
        "        fq, fquarters, flabels = self._future_quarters(int(qidx[-1]), periods)\n",
        "        ds_fc = np.array([ds[-1] * np.power(1 + qoq_growth, i) for i in range(1, periods+1)])\n",
        "        fc    = self._reseasonalise(ds_fc, fquarters)\n",
        "\n",
        "        return {'method':'cagr','forecast':fc,'qidx':fq,'quarters':fquarters,\n",
        "                'labels':flabels,'qoq_growth':qoq_growth}\n",
        "\n",
        "    def _forecast_exp_smoothing(self, df: pd.DataFrame, periods: int, alpha: float = 0.3) -> dict:\n",
        "        qidx  = df['qidx'].values\n",
        "        ds    = self._deseasonalise(df['sales'].values, df['quarter'].values)\n",
        "\n",
        "        sm = [ds[0]]\n",
        "        for v in ds[1:]:\n",
        "            sm.append(alpha * v + (1 - alpha) * sm[-1])\n",
        "        trend = sm[-1] - sm[-2] if len(sm) > 1 else 0\n",
        "\n",
        "        fq, fquarters, flabels = self._future_quarters(int(qidx[-1]), periods)\n",
        "        ds_fc = np.array([sm[-1] + trend * i for i in range(1, periods+1)])\n",
        "        fc    = self._reseasonalise(ds_fc, fquarters)\n",
        "\n",
        "        return {'method':'exp_smoothing','forecast':fc,'qidx':fq,'quarters':fquarters,\n",
        "                'labels':flabels,'alpha':alpha}\n",
        "\n",
        "    def _forecast_holt(self, df: pd.DataFrame, periods: int,\n",
        "                       alpha: float = 0.3, beta: float = 0.1) -> dict:\n",
        "        qidx  = df['qidx'].values\n",
        "        ds    = self._deseasonalise(df['sales'].values, df['quarter'].values)\n",
        "\n",
        "        level = ds[0]\n",
        "        trend = ds[1] - ds[0] if len(ds) > 1 else 0\n",
        "        for v in ds[1:]:\n",
        "            prev  = level\n",
        "            level = alpha * v + (1 - alpha) * (level + trend)\n",
        "            trend = beta * (level - prev) + (1 - beta) * trend\n",
        "\n",
        "        fq, fquarters, flabels = self._future_quarters(int(qidx[-1]), periods)\n",
        "        ds_fc = np.array([level + trend * i for i in range(1, periods+1)])\n",
        "        fc    = self._reseasonalise(ds_fc, fquarters)\n",
        "\n",
        "        return {'method':'holt','forecast':fc,'qidx':fq,'quarters':fquarters,\n",
        "                'labels':flabels,'final_level':level,'final_trend':trend}\n",
        "\n",
        "    def _forecast_ma_trend(self, df: pd.DataFrame, periods: int, window: int = 4) -> dict:\n",
        "        qidx  = df['qidx'].values\n",
        "        ds    = self._deseasonalise(df['sales'].values, df['quarter'].values)\n",
        "        gr    = np.diff(ds) / ds[:-1]\n",
        "        avg_g = np.mean(gr[-window:]) if len(gr) >= window else np.mean(gr)\n",
        "\n",
        "        fq, fquarters, flabels = self._future_quarters(int(qidx[-1]), periods)\n",
        "        fc_ds, last = [], ds[-1]\n",
        "        for _ in range(periods):\n",
        "            last = last * (1 + avg_g)\n",
        "            fc_ds.append(last)\n",
        "        fc = self._reseasonalise(np.array(fc_ds), fquarters)\n",
        "\n",
        "        return {'method':'ma_trend','forecast':fc,'qidx':fq,'quarters':fquarters,\n",
        "                'labels':flabels,'avg_growth':avg_g}\n",
        "\n",
        "    def _forecast_weighted_avg(self, df: pd.DataFrame, periods: int) -> dict:\n",
        "        qidx  = df['qidx'].values\n",
        "        ds    = self._deseasonalise(df['sales'].values, df['quarter'].values)\n",
        "        gr    = np.diff(ds) / ds[:-1]\n",
        "        weights = np.arange(1, len(gr) + 1)\n",
        "        wg    = np.average(gr, weights=weights)\n",
        "\n",
        "        fq, fquarters, flabels = self._future_quarters(int(qidx[-1]), periods)\n",
        "        fc_ds, last = [], ds[-1]\n",
        "        for _ in range(periods):\n",
        "            last = last * (1 + wg)\n",
        "            fc_ds.append(last)\n",
        "        fc = self._reseasonalise(np.array(fc_ds), fquarters)\n",
        "\n",
        "        return {'method':'weighted_avg','forecast':fc,'qidx':fq,'quarters':fquarters,\n",
        "                'labels':flabels,'weighted_growth':wg}\n",
        "\n",
        "    def _forecast_seasonal_naive(self, df: pd.DataFrame, periods: int) -> dict:\n",
        "        \"\"\"Repeat last year's quarter values with average YoY growth adjustment.\"\"\"\n",
        "        qidx = df['qidx'].values\n",
        "        sales = df['sales'].values\n",
        "        quarters = df['quarter'].values\n",
        "\n",
        "        fq, fquarters, flabels = self._future_quarters(int(qidx[-1]), periods)\n",
        "\n",
        "        # YoY growth rates for matching quarters\n",
        "        yearly_growth = []\n",
        "        for i in range(4, len(sales)):\n",
        "            if sales[i-4] > 0:\n",
        "                yearly_growth.append(sales[i] / sales[i-4] - 1)\n",
        "        avg_yoy = np.mean(yearly_growth) if yearly_growth else 0.0\n",
        "\n",
        "        fc = []\n",
        "        for i, (fqi, fq_q) in enumerate(zip(fq, fquarters)):\n",
        "            # Find matching historical quarter\n",
        "            mask = quarters == fq_q\n",
        "            if mask.any():\n",
        "                base = sales[mask][-1]\n",
        "                years_ahead = (i // 4) + 1\n",
        "                fc.append(base * np.power(1 + avg_yoy, years_ahead))\n",
        "            else:\n",
        "                fc.append(sales[-1])\n",
        "\n",
        "        return {'method':'seasonal_naive','forecast':np.array(fc),'qidx':fq,\n",
        "                'quarters':fquarters,'labels':flabels,'avg_yoy':avg_yoy}\n",
        "\n",
        "    # =========================================================================\n",
        "    # BACKTESTING\n",
        "    # =========================================================================\n",
        "\n",
        "    def backtest(self, holdout_quarters: int = 4, exclude_outliers: bool = True) -> pd.DataFrame:\n",
        "        df = self.data_excl_outliers if exclude_outliers else self.clean_data\n",
        "\n",
        "        if len(df) <= holdout_quarters + 4:\n",
        "            holdout_quarters = max(1, len(df) // 4)\n",
        "            print(f\"  Adjusted holdout to {holdout_quarters} quarters due to data size.\")\n",
        "\n",
        "        train = df.iloc[:-holdout_quarters].copy()\n",
        "        test  = df.iloc[-holdout_quarters:].copy()\n",
        "        actual = test['sales'].values\n",
        "\n",
        "        methods = {\n",
        "            'linear':         self._forecast_linear,\n",
        "            'cagr':           self._forecast_cagr,\n",
        "            'exp_smoothing':  self._forecast_exp_smoothing,\n",
        "            'holt':           self._forecast_holt,\n",
        "            'ma_trend':       self._forecast_ma_trend,\n",
        "            'weighted_avg':   self._forecast_weighted_avg,\n",
        "            'seasonal_naive': self._forecast_seasonal_naive,\n",
        "        }\n",
        "\n",
        "        results = []\n",
        "        for name, method in methods.items():\n",
        "            try:\n",
        "                res  = method(train, holdout_quarters)\n",
        "                pred = res['forecast']\n",
        "                mape = np.mean(np.abs(pred - actual) / actual) * 100\n",
        "                bias = np.mean(pred - actual)\n",
        "                rmse = np.sqrt(np.mean((pred - actual) ** 2))\n",
        "                results.append({'method':name,'mape':round(mape,2),\n",
        "                                 'bias':round(bias,1),'rmse':round(rmse,1)})\n",
        "            except Exception as e:\n",
        "                print(f\"  Method {name} failed: {e}\")\n",
        "\n",
        "        self.backtest_results = pd.DataFrame(results)\n",
        "        self.best_method = self.backtest_results.loc[\n",
        "            self.backtest_results['mape'].idxmin(), 'method'\n",
        "        ]\n",
        "\n",
        "        print(f\"\\n✓ Backtest complete (holdout: {holdout_quarters} quarters)\")\n",
        "        print(f\"  Best method: {self.best_method}\")\n",
        "        return self.backtest_results[['method','mape','bias','rmse']]\n",
        "\n",
        "    # =========================================================================\n",
        "    # GENERATE FORECASTS\n",
        "    # =========================================================================\n",
        "\n",
        "    def forecast(self, periods: int = 20, exclude_outliers: bool = True) -> pd.DataFrame:\n",
        "        df = self.data_excl_outliers if exclude_outliers else self.clean_data\n",
        "\n",
        "        methods = {\n",
        "            'linear':         self._forecast_linear,\n",
        "            'cagr':           self._forecast_cagr,\n",
        "            'exp_smoothing':  self._forecast_exp_smoothing,\n",
        "            'holt':           self._forecast_holt,\n",
        "            'ma_trend':       self._forecast_ma_trend,\n",
        "            'weighted_avg':   self._forecast_weighted_avg,\n",
        "            'seasonal_naive': self._forecast_seasonal_naive,\n",
        "        }\n",
        "\n",
        "        self.forecasts = {name: method(df, periods) for name, method in methods.items()}\n",
        "\n",
        "        # Base DataFrame\n",
        "        sample = next(iter(self.forecasts.values()))\n",
        "        results = pd.DataFrame({\n",
        "            'label':   sample['labels'],\n",
        "            'qidx':    sample['qidx'],\n",
        "            'quarter': sample['quarters'],\n",
        "        })\n",
        "\n",
        "        for name, fc in self.forecasts.items():\n",
        "            results[name] = np.round(fc['forecast'], 1)\n",
        "\n",
        "        # Ensemble: top-3 by backtest MAPE, or sensible default\n",
        "        if self.backtest_results is not None and len(self.backtest_results):\n",
        "            top3 = self.backtest_results.nsmallest(3,'mape')['method'].tolist()\n",
        "        else:\n",
        "            top3 = ['holt','seasonal_naive','weighted_avg']\n",
        "        results['ensemble'] = np.round(results[top3].mean(axis=1), 1)\n",
        "\n",
        "        # CI from linear (has explicit CI)\n",
        "        lin = self.forecasts['linear']\n",
        "        results['ci_lower'] = np.round(lin['ci_lower'], 1)\n",
        "        results['ci_upper'] = np.round(lin['ci_upper'], 1)\n",
        "\n",
        "        # Scenarios (percentile growth rates on de-seasonalised data)\n",
        "        ds_hist = self._deseasonalise(df['sales'].values, df['quarter'].values)\n",
        "        gr_hist = np.diff(ds_hist) / ds_hist[:-1]\n",
        "        scenarios = {\n",
        "            'pessimistic': np.percentile(gr_hist, 25),\n",
        "            'baseline':    np.median(gr_hist),\n",
        "            'optimistic':  np.percentile(gr_hist, 75),\n",
        "        }\n",
        "        for sc, g in scenarios.items():\n",
        "            sc_ds, last = [], ds_hist[-1]\n",
        "            for _ in range(periods):\n",
        "                last = last * (1 + g)\n",
        "                sc_ds.append(last)\n",
        "            results[f'scenario_{sc}'] = np.round(\n",
        "                self._reseasonalise(np.array(sc_ds), sample['quarters']), 1\n",
        "            )\n",
        "\n",
        "        self.final_forecast = results\n",
        "        fq_start = results['label'].iloc[0]\n",
        "        fq_end   = results['label'].iloc[-1]\n",
        "        print(f\"\\n✓ Generated {periods}-quarter forecast\")\n",
        "        print(f\"  Forecast period: {fq_start} – {fq_end}\")\n",
        "        return results\n",
        "\n",
        "    # =========================================================================\n",
        "    # FULL ANALYSIS\n",
        "    # =========================================================================\n",
        "\n",
        "    def run_full_analysis(self, forecast_periods: int = 20, holdout_quarters: int = 4) -> dict:\n",
        "        print(\"=\" * 65)\n",
        "        print(\"RETAILER QUARTERLY REVENUE FORECASTING ANALYSIS\")\n",
        "        print(\"=\" * 65)\n",
        "\n",
        "        # Summary\n",
        "        print(\"\\n DATA SUMMARY\")\n",
        "        print(\"-\" * 45)\n",
        "        s = self.summary_stats()\n",
        "        print(f\"  Period:              {s['first_quarter']} – {s['last_quarter']} ({s['n_quarters']} quarters)\")\n",
        "        print(f\"  Sales range:         {s['first_sales']:>12,.0f}  →  {s['last_sales']:>12,.0f}\")\n",
        "        print(f\"  Annual CAGR:         {s['annual_cagr_pct']:.1f}%\")\n",
        "        print(f\"  Avg QoQ growth:      {s['avg_qoq_growth_pct']:.1f}%\")\n",
        "        print(f\"  Growth volatility:   {s['growth_volatility']:.1f}%\")\n",
        "        print(f\"  Seasonal indices:    {s['seasonal_indices']}\")\n",
        "        if s['outliers_excluded']:\n",
        "            labels = self.clean_data.loc[\n",
        "                self.clean_data['qidx'].isin(s['outliers_excluded']), 'label'\n",
        "            ].tolist()\n",
        "            print(f\"  Outliers excluded:   {labels}\")\n",
        "\n",
        "        # Historical table\n",
        "        print(\"\\n HISTORICAL DATA\")\n",
        "        print(\"-\" * 45)\n",
        "        hist = self.clean_data.copy()\n",
        "        hist['qoq_growth_%'] = (hist['sales'].pct_change() * 100).round(1)\n",
        "        hist['yoy_growth_%'] = (hist['sales'].pct_change(4) * 100).round(1)\n",
        "        hist['outlier'] = hist['qidx'].isin(self.outliers).map({True:'⚠','False':''})\n",
        "        print(hist[['label','sales','qoq_growth_%','yoy_growth_%','outlier']].to_string(index=False))\n",
        "\n",
        "        # Backtest\n",
        "        print(\"\\n BACKTESTING\")\n",
        "        print(\"-\" * 45)\n",
        "        bt = self.backtest(holdout_quarters=holdout_quarters)\n",
        "        print(bt.to_string(index=False))\n",
        "\n",
        "        # Forecast\n",
        "        print(\"\\n FORECASTS\")\n",
        "        print(\"-\" * 45)\n",
        "        fc = self.forecast(periods=forecast_periods)\n",
        "        display_cols = ['label','ensemble','scenario_pessimistic','scenario_baseline','scenario_optimistic']\n",
        "        avail = [c for c in display_cols if c in fc.columns]\n",
        "        print(fc[avail].to_string(index=False))\n",
        "\n",
        "        # Growth rates\n",
        "        print(\"\\n IMPLIED GROWTH RATES (ensemble)\")\n",
        "        print(\"-\" * 45)\n",
        "        last_actual = self.clean_data['sales'].iloc[-1]\n",
        "        vals = [last_actual] + fc['ensemble'].tolist()\n",
        "        qoq  = [(vals[i+1]/vals[i]-1)*100 for i in range(len(vals)-1)]\n",
        "        growth_df = pd.DataFrame({\n",
        "            'quarter':      fc['label'],\n",
        "            'forecast':     fc['ensemble'],\n",
        "            'qoq_growth_%': [round(g,1) for g in qoq],\n",
        "        })\n",
        "        print(growth_df.to_string(index=False))\n",
        "\n",
        "        print(\"\\n\" + \"=\" * 65)\n",
        "        print(\"ANALYSIS COMPLETE\")\n",
        "        print(\"=\" * 65)\n",
        "\n",
        "        return {\n",
        "            'summary_stats':    s,\n",
        "            'historical_data':  hist,\n",
        "            'backtest_results': bt,\n",
        "            'forecasts':        fc,\n",
        "            'best_method':      self.best_method,\n",
        "        }\n",
        "\n",
        "    # =========================================================================\n",
        "    # EXPORT\n",
        "    # =========================================================================\n",
        "\n",
        "    def export_results(self, file_path: str = 'forecast_results_quarterly.xlsx') -> None:\n",
        "        with pd.ExcelWriter(file_path, engine='openpyxl') as writer:\n",
        "            hist = self.clean_data.copy()\n",
        "            hist['qoq_growth_%'] = (hist['sales'].pct_change() * 100).round(1)\n",
        "            hist['yoy_growth_%'] = (hist['sales'].pct_change(4) * 100).round(1)\n",
        "            hist.to_excel(writer, sheet_name='Historical', index=False)\n",
        "\n",
        "            if self.backtest_results is not None and len(self.backtest_results):\n",
        "                self.backtest_results[['method','mape','bias','rmse']].to_excel(\n",
        "                    writer, sheet_name='Backtest', index=False\n",
        "                )\n",
        "\n",
        "            if self.final_forecast is not None:\n",
        "                self.final_forecast.to_excel(writer, sheet_name='Forecasts', index=False)\n",
        "\n",
        "            stats_df = pd.DataFrame([self.summary_stats()])\n",
        "            stats_df.to_excel(writer, sheet_name='Summary', index=False)\n",
        "\n",
        "        print(f\"\\n✓ Results exported to: {file_path}\")\n",
        "\n",
        "    # =========================================================================\n",
        "    # VISUALISATION\n",
        "    # =========================================================================\n",
        "\n",
        "    def plot(self, save_path: str = None) -> None:\n",
        "        if not PLOTTING_AVAILABLE:\n",
        "            print(\"matplotlib not available. Install with: pip install matplotlib\")\n",
        "            return\n",
        "\n",
        "        fig, ax = plt.subplots(figsize=(14, 6))\n",
        "\n",
        "        hist   = self.clean_data\n",
        "        labels_hist = hist['label'].tolist()\n",
        "        x_hist = np.arange(len(labels_hist))\n",
        "\n",
        "        ax.plot(x_hist, hist['sales'], 'ko-', lw=2, ms=7, label='Historical', zorder=5)\n",
        "\n",
        "        # Mark outliers\n",
        "        if self.outliers:\n",
        "            ol = hist[hist['qidx'].isin(self.outliers)]\n",
        "            ol_x = [labels_hist.index(l) for l in ol['label'] if l in labels_hist]\n",
        "            ax.scatter(ol_x, ol['sales'].values[:len(ol_x)],\n",
        "                       color='red', s=150, zorder=6, label='Outlier', marker='x')\n",
        "\n",
        "        if self.final_forecast is not None:\n",
        "            fc     = self.final_forecast\n",
        "            # Offset x for forecast\n",
        "            bridge_x = len(labels_hist) - 1\n",
        "            fc_x   = np.arange(bridge_x, bridge_x + len(fc) + 1)\n",
        "            bridge_sales = [hist['sales'].iloc[-1]] + fc['ensemble'].tolist()\n",
        "\n",
        "            ax.plot(fc_x, bridge_sales, 'b--s', lw=2, ms=5,\n",
        "                    label='Ensemble Forecast')\n",
        "\n",
        "            if 'scenario_pessimistic' in fc.columns:\n",
        "                pess = [hist['sales'].iloc[-1]] + fc['scenario_pessimistic'].tolist()\n",
        "                opti = [hist['sales'].iloc[-1]] + fc['scenario_optimistic'].tolist()\n",
        "                ax.fill_between(fc_x, pess, opti, alpha=0.15, color='blue',\n",
        "                                label='Scenario Range')\n",
        "\n",
        "            # X-ticks: show every 4 quarters\n",
        "            all_labels = labels_hist + fc['label'].tolist()\n",
        "            tick_pos   = list(range(0, len(all_labels), 4))\n",
        "            ax.set_xticks(tick_pos)\n",
        "            ax.set_xticklabels([all_labels[i] for i in tick_pos], rotation=45, ha='right')\n",
        "\n",
        "        ax.set_xlabel('Quarter', fontsize=11)\n",
        "        ax.set_ylabel('Sales', fontsize=11)\n",
        "        ax.set_title('Retailer Quarterly Revenue: Historical & Forecast', fontsize=13)\n",
        "        ax.legend(loc='upper left')\n",
        "        ax.grid(True, alpha=0.3)\n",
        "\n",
        "        max_val = max(hist['sales'].max(),\n",
        "                      self.final_forecast['ensemble'].max() if self.final_forecast is not None else 0)\n",
        "        if max_val >= 1_000_000:\n",
        "            ax.yaxis.set_major_formatter(mticker.FuncFormatter(lambda x, _: f'{x/1e6:.1f}M'))\n",
        "        elif max_val >= 1_000:\n",
        "            ax.yaxis.set_major_formatter(mticker.FuncFormatter(lambda x, _: f'{x/1e3:.0f}K'))\n",
        "\n",
        "        plt.tight_layout()\n",
        "\n",
        "        if save_path:\n",
        "            plt.savefig(save_path, dpi=150, bbox_inches='tight')\n",
        "            print(f\"✓ Chart saved to: {save_path}\")\n",
        "\n",
        "        plt.show()\n",
        "\n",
        "\n",
        "# =============================================================================\n",
        "# MAIN\n",
        "# =============================================================================\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    forecaster = RetailerQuarterlyForecaster('Market data portal Quarterly.xlsx')\n",
        "    results = forecaster.run_full_analysis(forecast_periods=20, holdout_quarters=4)\n",
        "    forecaster.export_results('forecast_output_quarterly.xlsx')\n",
        "    forecaster.plot(save_path='forecast_chart_quarterly.png')"
