  "cards": [
    {
      "dot": "cyan",
      "title": "What it is for",
      "items": [
        "Turns a market-size history into a forecast the team can quote",
        "Data comes from the analyst, not our database — every request is different",
        "Three models run, so a number never rests on one method"
      ]
    },
    {
      "dot": "violet",
      "title": "Why three models",
      "items": [
        "SARIMAX links the market to the US economy, so it can answer what-if",
        "SARIMA uses history alone and cannot break on an outage",
        "Prophet finds where the trend bent, such as 2020"
      ]
    },
    {
      "dot": "rose",
      "title": "How to read the result",
      "items": [
        "Every model is scored on periods it never saw, so the ranking is fair",
        "Models within 5% of each other — quote the midpoint with confidence",
        "Further apart — give a range and say why"
      ]
    }
  ]
