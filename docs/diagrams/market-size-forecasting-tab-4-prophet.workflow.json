  "cards": [
    {
      "dot": "cyan",
      "title": "What it signifies",
      "items": [
        "A curve split into a bending trend plus a repeating seasonal shape",
        "Changepoints are dates where the growth rate actually changed",
        "covid_shock marks Mar–Jun 2020 so the crash is not read as trend",
        "Regressor value in points is how much that flag improved accuracy"
      ]
    },
    {
      "dot": "violet",
      "title": "Why it is used",
      "items": [
        "It handles trend breaks that SARIMA and SARIMAX smooth over",
        "It needs no stationarity and no order selection — nothing to tune",
        "It copes with gaps and irregular history better than the ARIMA family",
        "Changepoint dates are directly useful in a written market narrative"
      ]
    },
    {
      "dot": "rose",
      "title": "Read it this way",
      "items": [
        "A negative regressor value means the COVID flag did not help here",
        "Cross-validation is skipped on short history — walk-forward still runs",
        "Many changepoints on a short series usually means it is overfitting",
        "No FRED data is used, so this tab cannot answer scenario questions"
      ]
    }
  ]
