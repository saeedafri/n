    {
      "dot": "violet",
      "title": "Where the time goes",
      "items": [
        "First run does the real work; a repeat replays from cache",
        "FRED is cached 24 h, fitted results 168 h, both on /home",
        "Weekly is slowest: 52-period season, gated under 8 years"
      ]
    },
    {
      "dot": "rose",
      "title": "Known traps",
      "items": [
        "Dates must be period-END or cleaning yields 0 rows",
        "No FRED key means SARIMAX is skipped, not failed",
        "Quote the band across the horizon, never one number"
      ]
