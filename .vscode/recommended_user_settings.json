{
    "github.copilot.nextEditSuggestions.enabled": true,
    "chat.viewSessions.orientation": "stacked",
    "security.workspace.trust.untrustedFiles": "open",
    "chat.tools.global.autoApprove": true,
    "chat.agent.maxRequests": 1000,
    "chat.editing.confirmEditRequestRetry": false,
    "workbench.startupEditor": "none",
    "editor.minimap.enabled": false,
    "kimi.alwaysExpandThinking": true,
    "kimi.yoloMode": true,
    "explorer.confirmPasteNative": false,
    "kilo-code.debug": false,
    "kilo-code.allowedCommands": [
        "git log",
        "git diff",
        "git show"
    ],
    "kilo-code.deniedCommands": [],
    "explorer.confirmDelete": false,
    "editor.wrapOnEscapedLineFeeds": true,
    "editor.wordWrap": "on",
    "workbench.editor.wrapTabs": true,
    "notebook.output.wordWrap": true,
    "chat.editor.wordWrap": "on",
    "chat.mcp.gallery.enabled": true,
    "files.associations": {
        "*.md": "markdown"
    },
    "[markdown]": {
        "editor.unicodeHighlight.ambiguousCharacters": false,
        "editor.unicodeHighlight.invisibleCharacters": false,
        "diffEditor.ignoreTrimWhitespace": false,
        "editor.wordWrap": "on",
        "editor.quickSuggestions": {
            "comments": "off",
            "strings": "off",
            "other": "off"
        },
        "prettier.proseWrap": "always"
    },
    "kimi.enableNewConversationShortcut": true,
    "zenMode.silentNotifications": false,
    "git.showPushSuccessNotification": true,
    "git.supportCancellation": true,
    "terminal.integrated.persistentSessionScrollback": 100000,
    "terminal.integrated.scrollback": 100000,
    "terminal.integrated.shellIntegration.history": 100000,
    "explorer.confirmDragAndDrop": false,
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "git.confirmSync": false,
    "git.autofetch": true,
    "[css]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "python.analysis.diagnosticSeverityOverrides": {
        "reportGeneralTypeIssues": "none",
        "reportAttributeAccessIssue": "none",
        "reportIndexIssue": "none"
    },
    "claudeCode.preferredLocation": "panel",
    "claudeCode.selectedModel": "default",
    "markdown-preview-enhanced.enablePreviewZenMode": false,
    "[html]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "markdown.preview.breaks": true,
    "notebook.outline.showMarkdownHeadersOnly": false,
    "markdown.editor.drop.enabled": "always",
    "markdown.editor.pasteUrlAsFormattedLink.enabled": "always",
    "markdown.editor.filePaste.enabled": "always",
    "markdown.occurrencesHighlight.enabled": true,
    "markdown.preview.typographer": true,
    "workbench.editor.enablePreview": false,
    "editor.unicodeHighlight.invisibleCharacters": false,
    "editor.unicodeHighlight.ambiguousCharacters": false,
    "python.createEnvironment.trigger": "off",
    "python.terminal.useEnvFile": true,
    "python.analysis.aiHoverSummaries": true,
    "python.analysis.autoFormatStrings": true,
    "python.analysis.autoImportCompletions": true,
    "python.analysis.autoTranslateDocstrings": true,
    "python.analysis.cacheLSPData": true,
    "python.analysis.completeFunctionParens": true,
    "python.analysis.diagnosticMode": "workspace",
    "python.analysis.enableAsyncProgram": true,
    "python.analysis.enableExternalTypeServer": true,
    "python.analysis.enableMangleName": true,
    "python.analysis.enableParallelIndexing": true,
    "python.analysis.enableTroubleshootMissingImports": true,
    "python.analysis.extraCommitChars": true,
    "python.analysis.fixAll": ["source.unusedImports", "source.convertImportFormat"],
    "python.analysis.typeCheckingMode": "basic",
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.terminal.activateEnvironment": true,
    "python.terminal.activateEnvInCurrentTerminal": true,

    "================================================================================": "",
    "======================== NEW ADDITIONS FOR ZERO ERRORS =========================": "",
    "================================================================================": "",

    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.formatOnPaste": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit",
            "source.fixAll": "explicit"
        },
        "editor.rulers": [88, 120],
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false
    },
    "ruff.organizeImports": true,
    "ruff.fixAll": true,
    "ruff.lint.run": "onSave",
    "ruff.lint.select": ["E", "F", "I", "W", "UP", "B", "C4", "SIM"],
    "ruff.lint.ignore": ["E501", "E731", "B008", "B905"],
    "ruff.format.quoteStyle": "double",
    "ruff.format.indentStyle": "space",
    "ruff.format.lineEnding": "auto",
    "python.analysis.inlayHints.functionReturnTypes": true,
    "python.analysis.inlayHints.variableTypes": true,
    "python.analysis.inlayHints.callArgumentNames": "all",
    "python.analysis.importFormat": "absolute",
    "python.analysis.packageIndexDepths": [
        {"name": "sklearn", "depth": 2},
        {"name": "matplotlib", "depth": 2},
        {"name": "scipy", "depth": 2},
        {"name": "django", "depth": 2},
        {"name": "flask", "depth": 2},
        {"name": "fastapi", "depth": 2},
        {"name": "streamlit", "depth": 2},
        {"name": "pandas", "depth": 2},
        {"name": "numpy", "depth": 2},
        {"name": "plotly", "depth": 2}
    ],
    "python.analysis.extraPaths": ["${workspaceFolder}/app"],
    "python.analysis.include": ["app/**/*.py"],
    "python.analysis.exclude": [
        "**/__pycache__/**",
        "**/.venv/**",
        "**/.git/**",
        "**/.pytest_cache/**",
        "**/.mypy_cache/**",
        "**/node_modules/**",
        "**/.edgar_cache/**"
    ],
    "python.analysis.ignore": ["**/__pycache__/**", "**/.venv/**"],
    "python.analysis.stubPath": "",
    "python.analysis.userFileIndexingLimit": 5000,
    "python.analysis.autoSearchPaths": true,
    "python.analysis.useImportHeuristic": true,
    "python.analysis.supportRestructuredText": true,
    "python.analysis.supportDocstringTemplate": true,
    "python.analysis.docstringFormat": "google",
    "python.analysis.logLevel": "Error",
    "python.analysis.semanticHighlighting": true,
    "python.analysis.excludeFiles": [
        "**/__pycache__/**",
        "**/*.pyc",
        "**/.git/**",
        "**/.venv/**"
    ],
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.nosetestsEnabled": false,
    "python.testing.pytestPath": "pytest",
    "python.testing.autoTestDiscoverOnSaveEnabled": true,
    "files.exclude": {
        "**/__pycache__": true,
        "**/*.pyc": true,
        "**/.pytest_cache": true,
        "**/.mypy_cache": true,
        "**/.ruff_cache": true,
        "**/node_modules": true,
        "**/.git": true,
        "**/.DS_Store": true,
        "**/*.egg-info": true,
        "**/.coverage": true,
        "**/.vscode-test": true
    },
    "files.watcherExclude": {
        "**/.venv/**": true,
        "**/__pycache__/**": true,
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/node_modules/**": true
    },
    "search.exclude": {
        "**/.venv": true,
        "**/__pycache__": true,
        "**/*.pyc": true,
        "**/node_modules": true,
        "**/.git": true
    },
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true,
    "editor.codeActionsOnSave": {
        "source.fixAll": "explicit"
    },
    "editor.trimAutoWhitespace": true,
    "editor.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,
    "diffEditor.ignoreTrimWhitespace": false,
    "git.ignoreLimitWarning": true,
    "errorLens.enabled": true,
    "errorLens.messageEnabled": true,
    "errorLens.statusBarMessageEnabled": true
}
